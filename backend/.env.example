# === OTP Harvesting & Monitoring System ===
# Copy this file to .env and fill in your values

# --- Core ---
PROJECT_NAME="Email Credential Harvesting & Monitoring System"
API_V1_STR="/api/v1"
LOG_LEVEL="INFO"

# --- Database ---
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/otp_system"

# --- Redis ---
REDIS_URL="redis://localhost:6379/0"

# --- Security ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY="CHANGE_ME_generate_a_real_fernet_key"
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY="CHANGE_ME_generate_a_real_secret_key"

# --- CORS ---
CORS_ORIGINS='["http://localhost:3000"]'

# --- Gmail OAuth 2.0 ---
# See docs/GMAIL_SETUP.md for instructions on getting these
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:8000/api/v1/oauth/gmail/callback"

# --- Monitoring ---
POLLING_INTERVAL_SECONDS=30
MAX_CONSECUTIVE_FAILURES=5
