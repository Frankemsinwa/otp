# ============================================================
# Production Environment — VPS Deployment
# Place at repo root: /opt/otp/.env.production
# ============================================================

# ── Core ─────────────────────────────────────────────────────
PROJECT_NAME=OTP Harvesting & Monitoring Engine
API_V1_STR=/api/v1
LOG_LEVEL=INFO

# ── Database (internal Docker network) ───────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:changeme@db:5432/otp_system
REDIS_URL=redis://redis:6379/0

# ── Security ─────────────────────────────────────────────────
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_SECRET_KEY

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=["http://YOUR_VPS_IP", "https://YOUR_VPS_IP"]

# ── Gmail OAuth 2.0 ─────────────────────────────────────────
GMAIL_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GMAIL_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GMAIL_REDIRECT_URI=http://YOUR_VPS_IP/api/v1/oauth/gmail/callback
GMAIL_SCOPES=["https://www.googleapis.com/auth/gmail.readonly"]

# ── Yahoo OAuth 2.0 ─────────────────────────────────────────
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=http://YOUR_VPS_IP/api/v1/oauth/yahoo/callback

# ── SMS / Relay App ──────────────────────────────────────────
RELAY_APP_SECRET=070c7d6a29debce56db11d474ff1b4db

# ── Monitoring ───────────────────────────────────────────────
POLLING_INTERVAL_SECONDS=30
POLLING_JITTER_PERCENT=0.25
MIN_POLLING_INTERVAL=15

# ── Browser Spoofing ─────────────────────────────────────────
SPOOF_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
SPOOF_ACCEPT_LANGUAGE=en-US,en;q=0.9
SPOOF_ACCEPT_ENCODING=gzip, deflate, br

# ── OAuth Client Pools ───────────────────────────────────────
GMAIL_CLIENT_POOL=
YAHOO_CLIENT_POOL=

# ── IMAP IDLE ────────────────────────────────────────────────
USE_IMAP_IDLE=true
IMAP_IDLE_TIMEOUT=1800

# ── Rate Limiting ────────────────────────────────────────────
RESPECT_RETRY_AFTER=true
MAX_RETRIES_ON_429=3

# ── Turnstile ────────────────────────────────────────────────
ENABLE_TURNSTILE=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Proxy ────────────────────────────────────────────────────
PROXY_LIST=[]
PROXY_STRATEGY=sticky
